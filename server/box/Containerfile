# The image behind `box`: a plain Ubuntu with the tools an agent reaches for first. Everything else it can apt-get
# itself, as root, inside the container.
#
#   podman build -t localhost/coderra-box -f Containerfile .
#
# BASE is a tag that exists today; point it at a newer Ubuntu LTS when you want one.
ARG BASE=docker.io/library/ubuntu:24.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl fd-find git jq less locales openssh-client procps python3 python3-pip \
      python3-venv ripgrep sqlite3 unzip xz-utils \
 && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /root
CMD ["sleep", "infinity"]
